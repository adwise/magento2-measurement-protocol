{
  "name": "adwise/magento2-gamp",
  "description": "Adwise Magento 2 Google Analytics Measurement Protocol",
  "type": "magento2-module",
  "version": "2.0.3",
  "license": "MIT",
  "authors": [
    {
      "name": "Joost Groot Bruinderink",
      "email": "j.grootbruinderink@adwise.nl"
    },
    {
      "name": "Jeroen Balk",
      "email": "j.balk@adwise.nl"
    },
    {
      "name": "Noah Pluimers",
      "email": "n.pluimers@adwise.nl"
    }
  ],
  "autoload": {
    "files": [
      "registration.php"
    ],
    "psr-4": {
      "Adwise\\Analytics\\": ""
    }
  },
  "repositories": [
    {
      "type": "vcs",
      "url": "git@github.com:Adwise/magento2-measurement-protocol.git"
    }
  ],
  "require": {
    "ext-curl": "*"
  },
  "require-dev": {
    "magento/magento-coding-standard": "^41",
    "phpstan/phpstan": "^2.1",
    "bitexpert/phpstan-magento": "^0.44",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  }
}
